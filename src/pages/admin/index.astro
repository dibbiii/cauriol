---
// Pannello Sveltia CMS su /admin.
// È una rotta Astro (e non un public/admin/index.html) perché altrimenti
// in sviluppo la rotta [...slug].astro intercetterebbe /admin/.
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Gestione contenuti</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <!-- Sveltia dal pacchetto npm: Astro lo unisce al sito e lo serve dal nostro dominio,
         nessuna CDN esterna (la versione CDN caricherebbe risorse da unpkg e jsDelivr). -->
    <script>
      import { init } from "@sveltia/cms";
      init();
    </script>
  </body>
</html>
